{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entry.schema.json",
  "title": "Карточка скилла (frontmatter entry.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "summary", "origin", "author", "license", "agents", "roles", "tasks"],
  "properties": {
    "name": {
      "description": "Слаг, совпадает с именем папки в skills/",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "title": { "description": "Что делает, по-русски, для заголовка", "type": "string", "minLength": 3, "maxLength": 80 },
    "summary": { "description": "Одна фраза для списка и meta description", "type": "string", "minLength": 20, "maxLength": 180 },
    "origin": {
      "description": "own — мой; fork — моя редакция чужого; curated — чужой, отобран",
      "enum": ["own", "fork", "curated"]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "source": {
      "description": "Где лежит код. Обязателен у всех, кроме черновиков",
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit"],
      "properties": {
        "host": { "description": "Где лежит репозиторий; по умолчанию github", "enum": ["github", "sourcecraft"] },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "commit": { "description": "Проверенный коммит: его ставит установка с сайта", "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "path": { "description": "Папка скилла внутри репозитория, если не корень", "type": "string" },
        "skill": { "description": "Имя для npx skills add --skill, если отличается от name", "type": "string" }
      }
    },
    "upstream": {
      "description": "Для fork: откуда взято",
      "type": "object",
      "additionalProperties": false,
      "required": ["repo"],
      "properties": { "repo": { "type": "string" } }
    },
    "license": { "description": "SPDX-идентификатор или none", "type": "string" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["claude-code", "codex", "cursor", "gemini-cli", "opencode"] }
    },
    "roles": {
      "description": "Для кого: посадочные /dlya/<роль>; universal — витрина «полезно любому»",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["marketer", "product", "developer", "designer", "analyst", "writer", "manager", "researcher", "founder", "universal"] }
    },
    "tasks": {
      "description": "Слаги из tasks.yaml",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "install": {
      "description": "Способы установки сверх выводимых автоматически",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "description": "Если в репозитории есть .claude-plugin/marketplace.json",
          "type": "object",
          "additionalProperties": false,
          "required": ["marketplace", "plugin"],
          "properties": {
            "marketplace": { "type": "string" },
            "plugin": { "type": "string" }
          }
        },
        "note": { "type": "string" }
      }
    },
    "scan": {
      "description": "Уровень «в каталоге»: автоматический разбор на коммите source.commit (scripts/intake.mjs)",
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "files", "scripts", "runs_commands", "network", "outside_folder", "hidden_unicode"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "files": { "type": "integer", "minimum": 1 },
        "scripts": { "description": "Файлов с кодом", "type": "integer", "minimum": 0 },
        "runs_commands": { "type": "boolean" },
        "network": { "description": "Домены, к которым обращается код", "type": "array", "items": { "type": "string" } },
        "outside_folder": { "description": "Код трогает пути вне папки скилла", "type": "boolean" },
        "hidden_unicode": { "description": "Файлы с невидимыми символами", "type": "array", "items": { "type": "string" } },
        "spec_issues": { "description": "Расхождения SKILL.md со спецификацией Agent Skills", "type": "array", "items": { "type": "string" } },
        "note": { "description": "Что нашёл разбор, словами, после просмотра человеком", "type": "string" }
      }
    },
    "installed": {
      "description": "Уровень «установлен»: ставили с нуля, агент подхватил скилл",
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "agent"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "agent": { "enum": ["claude-code", "codex", "cursor", "gemini-cli", "opencode"] },
        "note": { "type": "string" }
      }
    },
    "includes": {
      "description": "Набор: слаги карточек, которые ставятся вместе с этой и отдельно на сайте не показываются",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "pinned": { "description": "Только порядок: закреплённые идут первыми", "type": "boolean" },
    "todo": {
      "description": "Чего не хватает карточке. why — нет текста «Зачем он мне» от автора каталога: сайт не показывает тело карточки",
      "enum": ["why"]
    },
    "draft": { "description": "Не публикуется: нет источника или проверки", "type": "boolean" }
  },
  "if": { "properties": { "draft": { "const": true } }, "required": ["draft"] },
  "else": { "required": ["source", "scan"] }
}
